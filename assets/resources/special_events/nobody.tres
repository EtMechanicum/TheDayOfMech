[resource]
script = ExtResource("2_owftc")
name = "nobody"
dialogues = Array[String](["Nobody.", "There's nobody.", "Not here at least.", "But I am.", "If I'm alone, do they exist? The other ones?", "If I lost my eyes, would the light still be out there?", "And they... Do they know that I am here?", "Do they know that I exist?", "I don't know.", "I don't know if they don't think about it,", "Or if they just decide not to care.", "And I?", "Do I care?", "Maybe  I've decided that I want to care, now.", "But tomorrow? ", "And the day after tomorrow?", "In a million years?", "Will I care?", "Probably not.", "It's cold. Not 'cold'. Just...", "The warmth is far away."])
