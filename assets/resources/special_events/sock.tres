dialogues = Array[String](["Uh. A sock.", "A sock.", "Mhmm. Alright.", "...", "...", "I wonder...", "I wonder who made you.", "Were you made in a factory?", "Or were you born by somebody's hands?", "...", "...", "Do you remember?", "Your maker, I mean.", "Did you use to have a home?", "Was it warm?", "...", "Yeah. I know. I know I'll never know.", "Isn't it sad?", "How the world forgets?", "Also.", "Isn't it great?", "That the world forgets?"])
