dialogues = Array[String](["My eyes hurt.", "Yet I feel good. And bad. Sick.", "It's a tasty uneasiness.", "We like it.", "Don't we?", "The stars.", "Always there.", "Splendid.", "Suspended.", "Forever.", "...", "...", "...", "I don't like here.", "And yet the warmth inside me makes me stay.", "Longer.", "Just a little longer.", "...", "...", "...", "Life is beautiful.", "The moon grins.", "I'm going home.", "Please, don't hug me. ", "I'm scared."])
